{
  "name": "yacana",
  "version": "0.0.0",
  "private": true,
  "description": "Privately mineable token on Aztec whose mining work is Barretenberg proving",
  "workspaces": [
    "apps/*",
    "packages/*",
    "protocol/*",
    "tools/*"
  ],
  "scripts": {
    "artifacts:commit": "bun protocol/contracts/scripts/commit-artifacts.ts",
    "bridge": "bun tools/deploy/scripts/bridge.ts",
    "codegen": "bun scripts/params-codegen.ts && bun run --cwd protocol/work-circuit compile && bun run --cwd protocol/work-circuit export-vk && bun run --cwd protocol/work-circuit compile && bun run --cwd protocol/work-circuit manifest",
    "contracts:compile": "bun run --cwd protocol/contracts compile",
    "contracts:test": "bun run --cwd protocol/contracts test",
    "deploy": "bun tools/deploy/src/deploy.ts",
    "e2e:agent": "tools/localnet/bin/agent.sh",
    "epoch:stats": "bun tools/deploy/scripts/epoch-stats.ts",
    "launch": "bun tools/deploy/scripts/launch.ts",
    "lint": "biome check . && sort-package-json --check package.json 'apps/*/package.json' 'packages/*/package.json' 'protocol/*/package.json' 'tools/*/package.json'",
    "lint:actions": "actionlint",
    "lint:fix": "biome check --write . && sort-package-json package.json 'apps/*/package.json' 'packages/*/package.json' 'protocol/*/package.json' 'tools/*/package.json'",
    "lint:shell": "shellcheck tools/localnet/bin/*.sh .husky/pre-commit .husky/commit-msg",
    "portal:build": "bun run --cwd protocol/portal build",
    "portal:test": "bun run --cwd protocol/portal test",
    "prepare": "husky",
    "record-rollup-address": "bun tools/deploy/scripts/record-rollup-address.ts",
    "rig": "bun tools/localnet/src/rig.ts",
    "site:build": "bun apps/site/src/assemble.ts",
    "site:deploy": "bun run --cwd apps/site deploy",
    "site:e2e": "bun run --cwd apps/site test:e2e",
    "site:wrangler": "cd apps/site && wrangler",
    "soak": "bun tools/deploy/scripts/soak.ts",
    "test": "bun test",
    "test:components": "bun run --filter './apps/*' --filter './packages/*' test:components",
    "test:e2e": "bun run --filter './apps/*' test:e2e",
    "typecheck": "tsc -b --force"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,jsonc}": [
      "biome check --write --no-errors-on-unmatched"
    ],
    "*.sh": [
      "shellcheck"
    ],
    ".github/workflows/*.yml": [
      "actionlint"
    ],
    "**/package.json": [
      "sort-package-json"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/bun": "^1.4.0",
    "@yacana/web-stats": "workspace:*",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "sort-package-json": "^4.0.0",
    "typescript": "~6"
  },
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": ">=1.4.0"
  }
}
