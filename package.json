{
  "name": "yacana",
  "version": "0.0.0",
  "private": true,
  "description": "Privately mineable token on Aztec whose mining work is Barretenberg proving",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "artifacts:commit": "bun packages/site/scripts/commit-artifacts.ts",
    "bridge": "bun packages/deploy/scripts/bridge.ts",
    "codegen": "bun scripts/params-codegen.ts && bun run --cwd packages/work-circuit compile && bun run --cwd packages/work-circuit export-vk && bun run --cwd packages/work-circuit compile && bun run --cwd packages/work-circuit manifest",
    "contracts:compile": "bun run --cwd packages/contracts compile",
    "contracts:test": "bun run --cwd packages/contracts test",
    "deploy": "bun packages/deploy/src/deploy.ts",
    "e2e:agent": "scripts/run/agent.sh",
    "epoch:stats": "bun packages/deploy/scripts/epoch-stats.ts",
    "launch": "bun packages/deploy/scripts/launch.ts",
    "lint": "biome check . && sort-package-json --check package.json 'packages/*/package.json'",
    "lint:actions": "actionlint",
    "lint:fix": "biome check --write . && sort-package-json package.json 'packages/*/package.json'",
    "lint:shell": "shellcheck scripts/run/*.sh .husky/pre-commit .husky/commit-msg",
    "portal:build": "bun run --cwd packages/portal build",
    "portal:test": "bun run --cwd packages/portal test",
    "prepare": "husky",
    "record-rollup-address": "bun packages/deploy/scripts/record-rollup-address.ts",
    "rig": "bun scripts/run/rig.ts",
    "site:build": "bun packages/site/src/assemble.ts",
    "site:deploy": "bun run --cwd packages/site deploy",
    "site:e2e": "bun run --cwd packages/site test:e2e",
    "site:wrangler": "cd packages/site && wrangler",
    "soak": "bun packages/deploy/scripts/soak.ts",
    "test": "bun test",
    "test:components": "bun run --filter './packages/*' test:components",
    "test:e2e": "bun run --filter './packages/*' test:e2e",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,jsonc}": [
      "biome check --write --no-errors-on-unmatched"
    ],
    "*.sh": [
      "shellcheck"
    ],
    ".github/workflows/*.yml": [
      "actionlint"
    ],
    "**/package.json": [
      "sort-package-json"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/bun": "^1.4.0",
    "@yacana/web-stats": "workspace:*",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "sort-package-json": "^4.0.0",
    "typescript": "~6"
  },
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": ">=1.4.0"
  }
}
