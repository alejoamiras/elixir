#[test]
fn ticket_digest_matches_miner_core() {
    assert_eq(ticket_digest(FIXTURE_PROOF), 0x53c0766147fee03aab759d7bde301729d6054f5ab245edd530b8e8bfaf2138a);
}

#[test]
fn low128_matches_miner_core() {
    assert_eq(low128(0x53c0766147fee03aab759d7bde301729d6054f5ab245edd530b8e8bfaf2138a), 0x9d6054f5ab245edd530b8e8bfaf2138a);
}

#[test]
fn deploy_domain_matches_miner_core() {
    let d = v_deploy();
    assert_eq(d, 0x3053d8092997d8abdbc33cc9d6260e3b741f3d54865230ca5e23ebcf2b76bf02);
}

fn v_deploy() -> Field {
    Poseidon2::hash(
        [
            DOM_DEPLOY,
            0x7a69,
            0x6c9467ce,
            0x1234,
            0x1,
        ],
        5,
    )
}

#[test]
fn secret_commitment_matches_miner_core() {
    let c = Poseidon2::hash([DOM_SECRET, 0x7, 0x1e57], 3);
    assert_eq(c, 0x20a80cde33ea16d7ffae7a6c042ca2a285495be3c14c75fa69430bf9119e1ca4);
}

#[test]
fn ticket_nullifier_matches_miner_core() {
    assert_eq(Poseidon2::hash([DOM_NULL, 0x53c0766147fee03aab759d7bde301729d6054f5ab245edd530b8e8bfaf2138a], 2), 0x27bc3f593d7e894847f162f16c66ca4ba2f45aad83d2829749198de6baf776f0);
}

#[test]
fn next_seed_matches_miner_core() {
    let s = Poseidon2::hash(
        [DOM_SEED, 0x5, 0x1, 0x53c0766147fee03aab759d7bde301729d6054f5ab245edd530b8e8bfaf2138a, 0x64],
        5,
    );
    assert_eq(s, 0x13e2f55814b36ea2a10ad693914af391cd8a23d81e6fc2aa0004d1ed2a2d6e4);
}

#[test]
fn retarget_matches_miner_core() {
    assert_eq(next_target(0x400000000000000000000000003039, 0x133), 0x417e4b17e4b17e4b17e4b17e4b493d);
}
