{
  "name": "@yacana/site",
  "version": "0.0.0",
  "private": true,
  "description": "The deployable: assembly of the three apps into one origin, the production artifact contract, the Workers",
  "type": "module",
  "scripts": {
    "build": "bun src/assemble.ts",
    "deploy": "bun src/assemble.ts && wrangler deploy",
    "deploy:www": "wrangler deploy -c www/wrangler.jsonc",
    "preview": "wrangler dev",
    "test": "bun test",
    "test:e2e": "playwright test",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@yacana/web-kit": "workspace:*",
    "@yacana/web-miner": "workspace:*",
    "@yacana/web-stats": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@yacana/deploy": "workspace:*",
    "typescript": "~6",
    "wrangler": "4.127.1"
  }
}
