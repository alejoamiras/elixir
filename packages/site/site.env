# The one public configuration of the three apps (docs/deployments.md). Contract addresses and
# class ids come from deployments/<profile>.json, never from here.
# The default node; a user may point the pages at any https node from the miner's settings.
VITE_AZTEC_NODE_URL=https://v5.testnet.rpc.aztec-labs.com
# WebAuthn relying party: production passkeys are bound to this hostname.
VITE_RP_ID=yacana.network
# This project's Workers previews are `<label>` + this suffix (version ids and branch aliases); a page served
# there may make keys, with the exact preview host as the relying party. Empty turns previews off.
VITE_PREVIEW_HOST_SUFFIX=-yacana.alejo-amiras.workers.dev
# 1 during mainnet's launch week: the landing's hero becomes the launch lottery.
VITE_LAUNCH_MODE=0
# The block explorer the pages link addresses, blocks and transactions to; `off` for no links.
VITE_EXPLORER_URL=https://testnet.aztecscan.xyz
