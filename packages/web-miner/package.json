{
  "name": "@yacana/web-miner",
  "version": "0.0.0",
  "private": true,
  "description": "Browser miner: embedded wallet, sponsored fees, W proved by bb.js in a Worker, claims proved in-page",
  "type": "module",
  "scripts": {
    "build": "bun scripts/fetch-crs.ts && bun scripts/copy-artifacts.ts && tsc -b && vite build",
    "dev": "bun scripts/fetch-crs.ts && bun scripts/copy-artifacts.ts && vite",
    "preview": "vite preview",
    "test:components": "vitest run",
    "test:e2e": "bun scripts/fetch-crs.ts && bun scripts/copy-artifacts.ts && playwright test",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@aztec-foundation/aztec-standards": "5.2.0",
    "@aztec/aztec.js": "5.2.0",
    "@aztec/bb.js": "5.2.0",
    "@aztec/constants": "5.2.0",
    "@aztec/foundation": "5.2.0",
    "@aztec/kv-store": "5.2.0",
    "@aztec/noir-contracts.js": "5.2.0",
    "@aztec/noir-noir_js": "5.2.0",
    "@aztec/stdlib": "5.2.0",
    "@aztec/wallets": "5.2.0",
    "@tailwindcss/vite": "^4",
    "idb-keyval": "^6",
    "jotai": "^2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwindcss": "^4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "jsdom": "^28",
    "typescript": "~6",
    "vite": "^8",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vitest": "^4"
  }
