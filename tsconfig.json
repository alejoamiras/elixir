{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM"],
    "types": ["bun"],
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["packages/*/src", "packages/*/scripts", "packages/*/e2e", "scripts", "*.ts"],
  "exclude": ["node_modules", "**/dist", "**/target", "packages/ui/src", "packages/web-miner/src"]
}
