{
  // The versioned origin: the Worker a retired version's last build moves to (docs/upgrades.md).
  // Built with YACANA_APP_ROLE=old (`bun run site:build`), which assembles into ../dist-old and
  // refuses the apex directory; the apps served here restore accounts, never create them, and mine
  // nothing — they exist to move what is left off the old version. Deployed with
  // `wrangler deploy -c v5/wrangler.jsonc`; taken down after the version's exit deadline.
  "$schema": "https://json.schemastore.org/wrangler.json",
  "name": "yacana-v5",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  // Versions get `<id>-yacana-v5.<account>.workers.dev` URLs: the old role's preview suffix.
  "preview_urls": true,
  "routes": [{ "pattern": "v5.yacana.network", "custom_domain": true }],
  "assets": {
    "directory": "../dist-old",
    "not_found_handling": "single-page-application"
  }
}
