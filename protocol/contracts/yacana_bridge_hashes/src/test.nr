use crate::{claim_content, exit_content, exit_log_tag, retire_content, send_ahead_content};
use aztec::hash::compute_secret_hash;
use aztec::protocol::address::EthAddress;

#[test]
fn exit_content_matches_bridge() {
    let c = exit_content(EthAddress::from_field(0x1e5700000000000000000000000000000000c0de), 12000000000000000000, 0x7a9);
    assert_eq(c, 0x9d521abdd01ba95415f102370235aa7299ef405b8070fe3c0117b79725efa4);
}

#[test]
fn send_ahead_content_matches_bridge() {
    let c = send_ahead_content(
        12000000000000000000,
        0x5ec2e7,
        EthAddress::from_field(0x00000000000000000000000000000000000000ff),
    );
    assert_eq(c, 0xd5075c13e11e8056aeb7a5eeec2e81b8dbd195d5cb4ec9ed8bb19972010e32);
}

